    "Tap the floor or a wall to place the banner" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바닥이나 벽을 탭하면 현수막이 놓여요"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "床か壁をタップすると横断幕が置かれます"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the floor or a wall to place the banner"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点一下地面或墙壁来放置横幅"
          }
        },
        "zh-Hant" : {
