          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvedněte otevřenou dlaň k fotoaparátu a spustíte časovač."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Løft en åben håndflade mod kameraet for at starte timeren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σηκώστε την ανοιχτή παλάμη προς την κάμερα για να ξεκινήσει το χρονόμετρο."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nosta avoin kämmen kameraa kohti käynnistääksesi ajastimen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angkat telapak tangan terbuka ke arah kamera untuk memulai timer."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold en åpen håndflate mot kameraet for å starte timeren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hef een open handpalm naar de camera om de timer te starten."
          }
