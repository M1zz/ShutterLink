    "The camera counts down out loud and blinks its light, so a group standing far away knows exactly when the photo is taken." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라가 소리 내어 숫자를 세고 불빛을 깜빡여서, 멀리 서 있는 사람들도 언제 찍히는지 정확히 알 수 있어요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラが声に出してカウントダウンし、ライトも点滅するので、離れて立つ人たちにも撮影のタイミングがはっきり伝わります。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera counts down out loud and blinks its light, so a group standing far away knows exactly when the photo is taken."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相机会语音倒计时并闪烁灯光，站得远的大家也能清楚知道什么时候拍照。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相機會語音倒數並閃爍燈光，站得遠的大家也能清楚知道什麼時候拍照。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера считает вслух и мигает подсветкой, поэтому даже далеко стоящая группа точно знает, когда будет снимок."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cámara cuenta atrás en voz alta y parpadea con su luz, así un grupo que está lejos sabe justo cuándo se hace la foto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera zählt laut herunter und blinkt mit ihrem Licht, damit auch eine weit entfernte Gruppe genau weiß, wann das Foto entsteht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil décompte à voix haute et fait clignoter sa lumière : même un groupe éloigné sait exactement quand la photo est prise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fotocamera conta alla rovescia a voce alta e fa lampeggiare la luce, così anche un gruppo lontano sa esattamente quando viene scattata la foto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A câmera faz a contagem em voz alta e pisca a luz, assim um grupo distante sabe exatamente quando a foto será tirada."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กล้องจะนับถอยหลังออกเสียงและกะพริบไฟ ทำให้กลุ่มที่ยืนไกลรู้ว่าจะถ่ายภาพเมื่อไหร่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera đếm ngược thành tiếng và nháy đèn, nên cả nhóm đứng xa cũng biết chính xác khi nào ảnh được chụp."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoaparát odpočítává nahlas a bliká světlem, takže i vzdálená skupina přesně ví, kdy se fotí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameraet tæller højt ned og blinker med lyset, så en gruppe, der står langt væk, ved præcis, hvornår billedet tages."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κάμερα μετρά αντίστροφα δυνατά και αναβοσβήνει το φως της, ώστε και μια παρέα που στέκεται μακριά να ξέρει ακριβώς πότε τραβιέται η φωτογραφία."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera laskee ääneen ja vilkuttaa valoa, joten kauempanakin seisova ryhmä tietää tarkalleen, milloin kuva otetaan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera menghitung mundur dengan suara dan mengedipkan lampunya, sehingga grup yang berdiri jauh tahu persis kapan foto diambil."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameraet teller ned høyt og blinker med lyset, slik at en gruppe som står langt unna, vet nøyaktig når bildet tas."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De camera telt hardop af en laat zijn lampje knipperen, zodat ook een groep die ver weg staat precies weet wanneer de foto wordt gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparat odlicza na głos i miga światłem, więc nawet odległa grupa wie dokładnie, kiedy zostanie zrobione zdjęcie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameran räknar ned högt och blinkar med ljuset, så även en grupp som står långt bort vet exakt när bilden tas."
          }
        }
      }
    },
