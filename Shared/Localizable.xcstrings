            "value" : "大きく1回拍手すると、タイマーが始まります。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clap loudly once to start the timer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
