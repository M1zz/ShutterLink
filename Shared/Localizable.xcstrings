          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el suelo o una pared para colocar la pancarta"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf den Boden oder eine Wand, um das Banner zu platzieren"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le sol ou un mur pour placer la banderole"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il pavimento o una parete per posizionare lo striscione"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no chão ou numa parede para posicionar a faixa"
