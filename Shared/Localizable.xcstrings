    "Place this iPhone on a tripod or lean it somewhere steady. Use the level and the people counter to frame everyone." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone을 삼각대에 올리거나 안정적인 곳에 세워 두세요. 수평계와 인원 카운터로 모두가 화면에 들어오게 맞출 수 있어요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneを三脚に載せるか、安定した場所に立てかけてください。水準器と人数カウンターで、全員が収まるように調整できます。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place this iPhone on a tripod or lean it somewhere steady. Use the level and the people counter to frame everyone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把这台 iPhone 固定在三脚架上，或靠在稳固的地方。借助水平仪和人数统计，把所有人都框进画面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把這台 iPhone 固定在腳架上，或靠在穩固的地方。借助水平儀和人數統計，把所有人都框進畫面。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поставьте этот iPhone на штатив или обоприте его о что-нибудь устойчивое. Уровень и счётчик людей помогут уместить в кадр всех."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca este iPhone en un trípode o apóyalo en un sitio estable. Usa el nivel y el contador de personas para encuadrar a todos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle dieses iPhone auf ein Stativ oder lehne es irgendwo stabil an. Mit Wasserwaage und Personenzähler bekommst du alle ins Bild."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez cet iPhone sur un trépied ou calez-le sur un support stable. Utilisez le niveau et le compteur de personnes pour cadrer tout le monde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti questo iPhone su un treppiede o appoggialo in un punto stabile. Usa la livella e il conta persone per inquadrare tutti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque este iPhone em um tripé ou apoie-o em um lugar firme. Use o nível e o contador de pessoas para enquadrar todo mundo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วาง iPhone เครื่องนี้บนขาตั้งกล้อง หรือพิงไว้กับที่มั่นคง ใช้ระดับน้ำและตัวนับจำนวนคนเพื่อจัดเฟรมให้ทุกคนอยู่ในภาพ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt iPhone này lên chân máy hoặc dựa vào chỗ chắc chắn. Dùng thước thủy và bộ đếm người để lấy hết mọi người vào khung."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postavte tento iPhone na stativ nebo ho opřete o něco pevného. Pomocí vodováhy a počítadla lidí dostanete do záběru všechny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt denne iPhone på et stativ, eller lad den læne sig mod noget stabilt. Brug vaterpasset og personælleren til at få alle med i billedet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τοποθετήστε αυτό το iPhone σε τρίποδο ή στηρίξτε το κάπου σταθερά. Χρησιμοποιήστε το αλφάδι και τον μετρητή ατόμων για να χωρέσουν όλοι στο κάδρο."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta tämä iPhone kolmijalalle tai nojaa se johonkin tukevaan. Vesivaa’an ja henkilölaskurin avulla saat kaikki kuvaan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letakkan iPhone ini di tripod atau sandarkan di tempat yang kokoh. Pakai waterpas dan penghitung orang agar semua orang masuk bingkai."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett denne iPhonen på et stativ, eller len den mot noe stødig. Bruk vateret og persontelleren for å få alle med i bildet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet deze iPhone op een statief of leun hem tegen iets stevigs. Gebruik de waterpas en de personenteller om iedereen in beeld te krijgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postaw ten iPhone na statywie lub oprzyj go o coś stabilnego. Poziomica i licznik osób pomogą zmieścić wszystkich w kadrze."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ställ den här iPhonen på ett stativ eller luta den mot något stabilt. Använd vattenpasset och personräknaren för att få med alla i bild."
          }
        }
      }
    },
    "Point the other iPhone's Camera at the QR code. The ShutterLink Remote App Clip opens without installing anything. Keep this app open while shooting." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 iPhone의 카메라로 QR 코드를 비추세요. 설치 없이 ShutterLink 리모컨 App Clip이 열립니다. 촬영하는 동안 이 앱을 열어 두세요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のiPhoneのカメラでQRコードを読み取ってください。インストール不要でShutterLinkリモコンのAppクリップが開きます。撮影中はこのアプリを開いたままにしておいてください。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Point the other iPhone's Camera at the QR code. The ShutterLink Remote App Clip opens without installing anything. Keep this app open while shooting."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用另一台 iPhone 的相机对准二维码，无需安装即可打开 ShutterLink 遥控器 App Clip。拍摄期间请保持此 App 开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用另一台 iPhone 的相機對準 QR code，不需安裝即可開啟 ShutterLink 遙控器 App Clip。拍攝期間請保持此 App 開啟。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наведите камеру другого iPhone на QR-код. Мини-приложение «Пульт ShutterLink» откроется без установки. Во время съёмки не закрывайте это приложение."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta la cámara del otro iPhone al código QR. El App Clip del control de ShutterLink se abre sin instalar nada. Mantén esta app abierta mientras haces fotos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte die Kamera des anderen iPhone auf den QR-Code. Der App Clip „ShutterLink Fernbedienung“ öffnet sich ohne Installation. Lass diese App beim Fotografieren geöffnet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pointez l’appareil photo de l’autre iPhone vers le code QR. L’App Clip Télécommande ShutterLink s’ouvre sans rien installer. Gardez cette app ouverte pendant la prise de vue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inquadra il codice QR con la fotocamera dell’altro iPhone. L’App Clip Telecomando ShutterLink si apre senza installare nulla. Tieni aperta questa app mentre scatti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aponte a câmera do outro iPhone para o QR code. O App Clip Controle ShutterLink abre sem instalar nada. Mantenha este app aberto enquanto fotografa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้กล้องของ iPhone อีกเครื่องสแกน QR code แล้ว App Clip รีโมต ShutterLink จะเปิดขึ้นโดยไม่ต้องติดตั้งอะไร เปิดแอปนี้ค้างไว้ระหว่างถ่ายภาพ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hướng camera của iPhone kia vào mã QR. App Clip Điều khiển ShutterLink sẽ mở ra mà không cần cài gì. Hãy để ứng dụng này mở trong lúc chụp."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namiřte fotoaparát druhého iPhonu na QR kód. App Clip Ovladač ShutterLink se otevře bez instalace. Při focení nechte tuto aplikaci otevřenou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ret den anden iPhones kamera mod QR-koden. App Clip’en ShutterLink-fjernbetjening åbner uden installation. Hold denne app åben, mens du tager billeder."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στρέψτε την κάμερα του άλλου iPhone στον κωδικό QR. Το App Clip Τηλεχειριστήριο ShutterLink ανοίγει χωρίς εγκατάσταση. Κρατήστε αυτή την εφαρμογή ανοιχτή κατά τη λήψη."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoita toisen iPhonen kameralla QR-koodia. ShutterLink-kaukosäädin-App Clip aukeaa ilman asennusta. Pidä tämä sovellus auki kuvauksen ajan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arahkan Kamera iPhone lain ke kode QR. App Clip Remote ShutterLink terbuka tanpa perlu memasang apa pun. Biarkan app ini terbuka saat memotret."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rett kameraet på den andre iPhonen mot QR-koden. App Clip-en ShutterLink-fjernkontroll åpnes uten installasjon. Hold denne appen åpen mens du tar bilder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richt de camera van de andere iPhone op de QR-code. De App Clip ShutterLink-afstandsbediening opent zonder iets te installeren. Laat deze app open tijdens het fotograferen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skieruj aparat drugiego iPhone’a na kod QR. App Clip Pilot ShutterLink otworzy się bez instalowania czegokolwiek. Podczas robienia zdjęć nie zamykaj tej aplikacji."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rikta den andra iPhonens kamera mot QR-koden. App Clip-en ShutterLink-fjärrkontroll öppnas utan installation. Håll den här appen öppen medan du fotograferar."
          }
        }
      }
    },
    "Raise an open palm toward the camera to start the timer." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라를 향해 손바닥을 펴서 들면 타이머가 시작됩니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラに向けて手のひらを開いて掲げると、タイマーが始まります。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raise an open palm toward the camera to start the timer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向镜头举起张开的手掌，开始倒计时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
