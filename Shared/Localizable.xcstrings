    "Tap the QR button. Another iPhone scans it with the Camera app and becomes a remote in seconds, without installing anything." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR 버튼을 누르세요. 다른 iPhone이 카메라 앱으로 스캔하면 설치 없이 몇 초 만에 리모컨이 됩니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QRボタンをタップ。別のiPhoneが標準のカメラで読み取るだけで、インストール不要で数秒でリモコンになります。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the QR button. Another iPhone scans it with the Camera app and becomes a remote in seconds, without installing anything."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点一下二维码按钮，另一台 iPhone 用相机 App 扫描后，几秒内就能变成遥控器，无需安装任何东西。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下 QR code 按鈕，另一台 iPhone 用相機 App 掃描後，幾秒內就能變成遙控器，不需安裝任何東西。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите кнопку QR. Другой iPhone отсканирует код в приложении «Камера» и за пару секунд станет пультом — без установки."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el botón QR. Otro iPhone lo escanea con la app Cámara y en segundos se convierte en control, sin instalar nada."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf die QR-Taste. Ein anderes iPhone scannt den Code mit der Kamera-App und wird in Sekunden zur Fernbedienung, ganz ohne Installation."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le bouton QR. Un autre iPhone le scanne avec l’app Appareil photo et devient une télécommande en quelques secondes, sans rien installer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il pulsante QR. Un altro iPhone lo scansiona con l’app Fotocamera e in pochi secondi diventa un telecomando, senza installare nulla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no botão QR. Outro iPhone lê o código com o app Câmera e vira um controle em segundos, sem instalar nada."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะปุ่ม QR แล้ว iPhone อีกเครื่องสแกนด้วยแอปกล้อง ก็กลายเป็นรีโมตได้ในไม่กี่วินาทีโดยไม่ต้องติดตั้งอะไร"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm vào nút QR. iPhone khác quét bằng ứng dụng Camera và thành điều khiển trong vài giây, không cần cài gì."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepněte na tlačítko QR. Druhý iPhone ho naskenuje aplikací Fotoaparát a během pár sekund se z něj stane ovladač, bez jakékoli instalace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på QR-knappen. En anden iPhone scanner den med Kamera-appen og bliver til en fjernbetjening på få sekunder uden at installere noget."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε το κουμπί QR. Ένα άλλο iPhone το σαρώνει με την εφαρμογή Κάμερα και γίνεται τηλεχειριστήριο σε δευτερόλεπτα, χωρίς εγκατάσταση."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta QR-painiketta. Toinen iPhone skannaa sen Kamera-sovelluksella ja muuttuu kaukosäätimeksi sekunneissa ilman asennusta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk tombol QR. iPhone lain memindainya dengan app Kamera dan dalam hitungan detik menjadi remote, tanpa memasang apa pun."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på QR-knappen. En annen iPhone skanner den med Kamera-appen og blir en fjernkontroll på få sekunder, uten å installere noe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op de QR-knop. Een andere iPhone scant de code met de Camera-app en wordt in enkele seconden een afstandsbediening, zonder iets te installeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij przycisku QR. Drugi iPhone zeskanuje kod aplikacją Aparat i w kilka sekund stanie się pilotem — bez instalowania czegokolwiek."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på QR-knappen. En annan iPhone skannar den med appen Kamera och blir en fjärrkontroll på några sekunder, utan att installera något."
          }
        }
      }
    },
