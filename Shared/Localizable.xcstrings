    "Photos and videos you take with ShutterLink appear here." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink로 찍은 사진과 동영상이 여기에 표시됩니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLinkで撮影した写真やビデオがここに表示されます。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos and videos you take with ShutterLink appear here."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你用 ShutterLink 拍摄的照片和视频会显示在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你用 ShutterLink 拍攝的照片和影片會顯示在這裡。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото и видео, снятые в ShutterLink, появятся здесь."
          }
        }
      }
    },
    "Photos from this session" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
