    },
    "%lld photos, pick best": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld장 촬영 후 베스트 선택"
          }
        }
      }
    },
    "%lld remote connected": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리모컨 %lld대 연결됨"
          }
        }
      }
    },
    "%lld selected": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 선택됨"
          }
        }
      }
    },
    "%llds": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld초"
          }
        }
