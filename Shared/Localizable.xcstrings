        }
      }
    },
    "Raise your palm, clap, or let ShutterLink shoot when everyone smiles. A voice and light countdown tells the group when to pose." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손바닥을 들거나 박수를 치거나, 모두 웃을 때 자동으로 찍게 하세요. 음성과 불빛 카운트다운이 포즈 잡을 타이밍을 알려 줍니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手のひらを掲げる、拍手する、または全員が笑ったら自動で撮影。音声と光のカウントダウンで、ポーズのタイミングをみんなに伝えます。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raise your palm, clap, or let ShutterLink shoot when everyone smiles. A voice and light countdown tells the group when to pose."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "举起手掌、拍手，或者在大家微笑时让 ShutterLink 自动拍摄。语音和灯光倒计时会提醒大家摆好姿势。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "舉起手掌、拍手，或在大家微笑時讓 ShutterLink 自動拍攝。語音和燈光倒數會提醒大家擺好姿勢。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поднимите ладонь, хлопните или дайте ShutterLink снять, когда все улыбаются. Голосовой и световой отсчёт подскажет группе, когда позировать."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levanta la palma, da una palmada o deja que ShutterLink dispare cuando todos sonrían. Una cuenta atrás con voz y luz avisa al grupo de cuándo posar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heb die Handfläche, klatsche oder lass ShutterLink auslösen, wenn alle lächeln. Ein Countdown mit Stimme und Licht sagt der Gruppe, wann sie posieren soll."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levez la paume, applaudissez ou laissez ShutterLink déclencher quand tout le monde sourit. Un compte à rebours vocal et lumineux indique au groupe quand poser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alza il palmo, batti le mani o lascia che ShutterLink scatti quando tutti sorridono. Un conto alla rovescia con voce e luce dice al gruppo quando mettersi in posa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levante a palma, bata palmas ou deixe o ShutterLink disparar quando todos sorrirem. Uma contagem regressiva com voz e luz avisa ao grupo a hora de posar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยกฝ่ามือ ปรบมือ หรือให้ ShutterLink ถ่ายเองเมื่อทุกคนยิ้ม การนับถอยหลังด้วยเสียงและแสงจะบอกให้ทุกคนเตรียมโพสต์ท่า"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giơ lòng bàn tay, vỗ tay, hoặc để ShutterLink tự chụp khi mọi người cười. Đếm ngược bằng giọng nói và ánh sáng cho cả nhóm biết lúc nào tạo dáng."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvedněte dlaň, tleskněte, nebo nechte ShutterLink vyfotit, když se všichni usmívají. Hlasový a světelný odpočet skupině napoví, kdy se postavit do pozice."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Løft håndfladen, klap, eller lad ShutterLink tage billedet, når alle smiler. En nedtælling med stemme og lys fortæller gruppen, hvornår de skal stille op."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σηκώστε την παλάμη, χειροκροτήστε ή αφήστε το ShutterLink να τραβήξει όταν όλοι χαμογελούν. Μια αντίστροφη μέτρηση με φωνή και φως λέει στην παρέα πότε να ποζάρει."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nosta kämmen, taputa tai anna ShutterLinkin ottaa kuva, kun kaikki hymyilevät. Äänellä ja valolla annettu lähtölaskenta kertoo ryhmälle, milloin poseerata."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angkat telapak tangan, bertepuk tangan, atau biarkan ShutterLink memotret saat semua tersenyum. Hitung mundur suara dan cahaya memberi tahu grup kapan harus bergaya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Løft håndflaten, klapp, eller la ShutterLink ta bildet når alle smiler. En nedtelling med stemme og lys forteller gruppen når de skal stille opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hef je handpalm, klap, of laat ShutterLink afdrukken zodra iedereen lacht. Een aftelling met stem en licht laat de groep weten wanneer ze moet poseren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unieś dłoń, klaśnij albo pozwól ShutterLink zrobić zdjęcie, gdy wszyscy się uśmiechają. Odliczanie głosem i światłem podpowiada grupie, kiedy pozować."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll upp handflatan, klappa eller låt ShutterLink ta bilden när alla ler. En nedräkning med röst och ljus talar om för gruppen när det är dags att posera."
          }
        }
      }
    },
