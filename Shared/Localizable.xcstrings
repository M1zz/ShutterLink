    "They stay in your Photos library if they were saved there." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 앱에 저장된 사본은 그대로 남아 있습니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真に保存済みのものは、そのまま残ります。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They stay in your Photos library if they were saved there."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果已存入相册，它们会继续保留在你的相册中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果已儲存到相簿，它們會繼續保留在你的相簿中。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Они останутся в вашей медиатеке, если были туда сохранены."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quedan en tu fototeca si se guardaron allí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie bleiben in deiner Fotomediathek, wenn sie dort gesichert wurden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles restent dans votre photothèque si elles y ont été enregistrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restano nella libreria Foto se vi erano state salvate."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elas continuam na sua fototeca se foram salvas lá."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภาพที่บันทึกไว้ในคลังรูปภาพแล้วจะยังอยู่ที่เดิม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ảnh vẫn nằm trong thư viện Ảnh nếu đã được lưu ở đó."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zůstanou ve vaší knihovně Fotek, pokud se tam uložily."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bliver i dit fotobibliotek, hvis de blev gemt der."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παραμένουν στη βιβλιοθήκη φωτογραφιών σας αν είχαν αποθηκευτεί εκεί."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne säilyvät kuvakirjastossasi, jos ne tallennettiin sinne."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto tetap ada di pustaka Foto Anda jika sudah tersimpan di sana."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De blir værende i bildebiblioteket ditt hvis de ble lagret der."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze blijven in je fotobibliotheek staan als ze daar zijn bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostają w Twojej bibliotece zdjęć, jeśli tam je zapisano."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ligger kvar i ditt fotobibliotek om de sparades där."
          }
        }
      }
    },
