    "Couldn't find the camera. Make sure ShutterLink is open on the camera iPhone and Bluetooth is on." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라를 찾지 못했습니다. 카메라 iPhone에서 ShutterLink가 열려 있고 Bluetooth가 켜져 있는지 확인하세요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラが見つかりません。撮影側のiPhoneでShutterLinkが開いていて、Bluetoothがオンになっているか確認してください。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't find the camera. Make sure ShutterLink is open on the camera iPhone and Bluetooth is on."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到相机。请确认拍摄用的 iPhone 上已打开 ShutterLink，并且蓝牙已开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到相機。請確認拍攝用的 iPhone 已開啟 ShutterLink，且藍牙已開啟。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера не найдена. Убедитесь, что на снимающем iPhone открыт ShutterLink и включён Bluetooth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encuentra la cámara. Comprueba que ShutterLink esté abierto en el iPhone de la cámara y que Bluetooth esté activado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera nicht gefunden. Stelle sicher, dass ShutterLink auf dem Kamera-iPhone geöffnet und Bluetooth eingeschaltet ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appareil photo introuvable. Vérifiez que ShutterLink est ouvert sur l’iPhone photographe et que le Bluetooth est activé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotocamera non trovata. Assicurati che ShutterLink sia aperto sull’iPhone fotocamera e che il Bluetooth sia attivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível encontrar a câmera. Confira se o ShutterLink está aberto no iPhone da câmera e se o Bluetooth está ligado."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่พบกล้อง ตรวจสอบว่าเปิด ShutterLink บน iPhone ตัวถ่ายภาพ และเปิด Bluetooth อยู่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không tìm thấy camera. Hãy chắc chắn ShutterLink đang mở trên iPhone chụp và Bluetooth đã bật."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoaparát se nepodařilo najít. Ujistěte se, že je na iPhonu s fotoaparátem otevřený ShutterLink a zapnutý Bluetooth."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameraet blev ikke fundet. Sørg for, at ShutterLink er åben på kamera-iPhonen, og at Bluetooth er slået til."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κάμερα δεν βρέθηκε. Βεβαιωθείτε ότι το ShutterLink είναι ανοιχτό στο iPhone της κάμερας και ότι το Bluetooth είναι ενεργό."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameraa ei löytynyt. Varmista, että ShutterLink on auki kuvaavassa iPhonessa ja Bluetooth on päällä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera tidak ditemukan. Pastikan ShutterLink terbuka di iPhone kamera dan Bluetooth menyala."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fant ikke kameraet. Kontroller at ShutterLink er åpen på kamera-iPhonen og at Bluetooth er på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera niet gevonden. Zorg dat ShutterLink open staat op de iPhone met de camera en dat Bluetooth aan staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie znaleziono aparatu. Upewnij się, że ShutterLink jest otwarty na iPhonie z aparatem, a Bluetooth jest włączony."
          }
        },
        "sv" : {
