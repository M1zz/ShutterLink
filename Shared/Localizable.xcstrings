    "People standing in front of the banner now show over it." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현수막 앞에 선 사람이 현수막 위로 보여요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "横断幕の前に立つ人が、横断幕の手前に表示されます。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "People standing in front of the banner now show over it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在，站在横幅前面的人会显示在横幅之上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在，站在布條前面的人會顯示在布條之上。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теперь люди, стоящие перед баннером, отображаются поверх него."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora las personas que están delante de la pancarta se ven por encima de ella."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personen, die vor dem Banner stehen, werden jetzt über dem Banner angezeigt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les personnes devant la banderole s’affichent désormais par-dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora le persone davanti allo striscione compaiono sopra di esso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agora as pessoas na frente da faixa aparecem por cima dela."
