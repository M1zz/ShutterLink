    "Place this iPhone on a tripod or lean it somewhere steady. Use the level and the people counter to frame everyone." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone을 삼각대에 올리거나 안정적인 곳에 세워 두세요. 수평계와 인원 카운터로 모두가 화면에 들어오게 맞출 수 있어요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneを三脚に載せるか、安定した場所に立てかけてください。水準器と人数カウンターで、全員が収まるように調整できます。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place this iPhone on a tripod or lean it somewhere steady. Use the level and the people counter to frame everyone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把这台 iPhone 固定在三脚架上，或靠在稳固的地方。借助水平仪和人数统计，把所有人都框进画面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把這台 iPhone 固定在腳架上，或靠在穩固的地方。借助水平儀和人數統計，把所有人都框進畫面。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поставьте этот iPhone на штатив или обоприте его о что-нибудь устойчивое. Уровень и счётчик людей помогут уместить в кадр всех."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca este iPhone en un trípode o apóyalo en un sitio estable. Usa el nivel y el contador de personas para encuadrar a todos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle dieses iPhone auf ein Stativ oder lehne es irgendwo stabil an. Mit Wasserwaage und Personenzähler bekommst du alle ins Bild."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez cet iPhone sur un trépied ou calez-le sur un support stable. Utilisez le niveau et le compteur de personnes pour cadrer tout le monde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti questo iPhone su un treppiede o appoggialo in un punto stabile. Usa la livella e il conta persone per inquadrare tutti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque este iPhone em um tripé ou apoie-o em um lugar firme. Use o nível e o contador de pessoas para enquadrar todo mundo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วาง iPhone เครื่องนี้บนขาตั้งกล้อง หรือพิงไว้กับที่มั่นคง ใช้ระดับน้ำและตัวนับจำนวนคนเพื่อจัดเฟรมให้ทุกคนอยู่ในภาพ"
          }
        }
      }
    },
    "Point the other iPhone's Camera at the QR code. The ShutterLink Remote App Clip opens without installing anything. Keep this app open while shooting." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 iPhone의 카메라로 QR 코드를 비추세요. 설치 없이 ShutterLink 리모컨 App Clip이 열립니다. 촬영하는 동안 이 앱을 열어 두세요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のiPhoneのカメラでQRコードを読み取ってください。インストール不要でShutterLinkリモコンのAppクリップが開きます。撮影中はこのアプリを開いたままにしておいてください。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Point the other iPhone's Camera at the QR code. The ShutterLink Remote App Clip opens without installing anything. Keep this app open while shooting."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用另一台 iPhone 的相机对准二维码，无需安装即可打开 ShutterLink 遥控器 App Clip。拍摄期间请保持此 App 开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用另一台 iPhone 的相機對準 QR code，不需安裝即可開啟 ShutterLink 遙控器 App Clip。拍攝期間請保持此 App 開啟。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наведите камеру другого iPhone на QR-код. Мини-приложение «Пульт ShutterLink» откроется без установки. Во время съёмки не закрывайте это приложение."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta la cámara del otro iPhone al código QR. El App Clip del control de ShutterLink se abre sin instalar nada. Mantén esta app abierta mientras haces fotos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte die Kamera des anderen iPhone auf den QR-Code. Der App Clip „ShutterLink Fernbedienung“ öffnet sich ohne Installation. Lass diese App beim Fotografieren geöffnet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pointez l’appareil photo de l’autre iPhone vers le code QR. L’App Clip Télécommande ShutterLink s’ouvre sans rien installer. Gardez cette app ouverte pendant la prise de vue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inquadra il codice QR con la fotocamera dell’altro iPhone. L’App Clip Telecomando ShutterLink si apre senza installare nulla. Tieni aperta questa app mentre scatti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aponte a câmera do outro iPhone para o QR code. O App Clip Controle ShutterLink abre sem instalar nada. Mantenha este app aberto enquanto fotografa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้กล้องของ iPhone อีกเครื่องสแกน QR code แล้ว App Clip รีโมต ShutterLink จะเปิดขึ้นโดยไม่ต้องติดตั้งอะไร เปิดแอปนี้ค้างไว้ระหว่างถ่ายภาพ"
          }
        }
      }
    },
    "Raise an open palm toward the camera to start the timer." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라를 향해 손바닥을 펴서 들면 타이머가 시작됩니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラに向けて手のひらを開いて掲げると、タイマーが始まります。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raise an open palm toward the camera to start the timer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向镜头举起张开的手掌，开始倒计时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朝鏡頭舉起張開的手掌，開始倒數。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поднимите раскрытую ладонь к камере, чтобы запустить таймер."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levanta la palma abierta hacia la cámara para iniciar el temporizador."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die offene Handfläche in Richtung Kamera, um den Timer zu starten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levez la paume ouverte vers l’appareil photo pour lancer le minuteur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alza il palmo aperto verso la fotocamera per avviare il timer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levante a palma aberta para a câmera para iniciar o temporizador."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยกฝ่ามือที่แบออกไปทางกล้องเพื่อเริ่มจับเวลา"
          }
        }
      }
    },
    "Raise your palm, clap, or let ShutterLink shoot when everyone smiles. A voice and light countdown tells the group when to pose." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손바닥을 들거나 박수를 치거나, 모두 웃을 때 자동으로 찍게 하세요. 음성과 불빛 카운트다운이 포즈 잡을 타이밍을 알려 줍니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手のひらを掲げる、拍手する、または全員が笑ったら自動で撮影。音声と光のカウントダウンで、ポーズのタイミングをみんなに伝えます。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raise your palm, clap, or let ShutterLink shoot when everyone smiles. A voice and light countdown tells the group when to pose."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "举起手掌、拍手，或者在大家微笑时让 ShutterLink 自动拍摄。语音和灯光倒计时会提醒大家摆好姿势。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "舉起手掌、拍手，或在大家微笑時讓 ShutterLink 自動拍攝。語音和燈光倒數會提醒大家擺好姿勢。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поднимите ладонь, хлопните или дайте ShutterLink снять, когда все улыбаются. Голосовой и световой отсчёт подскажет группе, когда позировать."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levanta la palma, da una palmada o deja que ShutterLink dispare cuando todos sonrían. Una cuenta atrás con voz y luz avisa al grupo de cuándo posar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heb die Handfläche, klatsche oder lass ShutterLink auslösen, wenn alle lächeln. Ein Countdown mit Stimme und Licht sagt der Gruppe, wann sie posieren soll."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levez la paume, applaudissez ou laissez ShutterLink déclencher quand tout le monde sourit. Un compte à rebours vocal et lumineux indique au groupe quand poser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alza il palmo, batti le mani o lascia che ShutterLink scatti quando tutti sorridono. Un conto alla rovescia con voce e luce dice al gruppo quando mettersi in posa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levante a palma, bata palmas ou deixe o ShutterLink disparar quando todos sorrirem. Uma contagem regressiva com voz e luz avisa ao grupo a hora de posar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยกฝ่ามือ ปรบมือ หรือให้ ShutterLink ถ่ายเองเมื่อทุกคนยิ้ม การนับถอยหลังด้วยเสียงและแสงจะบอกให้ทุกคนเตรียมโพสต์ท่า"
          }
        }
      }
    },
    "Recording failed." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹화에 실패했습니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録画に失敗しました。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recording failed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制失败。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錄影失敗。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось записать."
          }
        },
