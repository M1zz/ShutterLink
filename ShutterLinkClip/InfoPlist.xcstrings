    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink Remote uses Bluetooth to control the camera iPhone nearby."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주변의 카메라 iPhone을 조종하기 위해 Bluetooth를 사용합니다."
          }
        },
        "ja" : {
          "stringUnit" : {
