    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink uses Bluetooth so a nearby iPhone can act as a remote shutter."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주변 iPhone을 리모컨 셔터로 쓰기 위해 Bluetooth를 사용합니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くのiPhoneをリモコンシャッターとして使うために、Bluetoothを使用します。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink uses Bluetooth so a nearby iPhone can act as a remote shutter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink 使用蓝牙，让附近的 iPhone 可以作为遥控快门。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink 使用藍牙，讓附近的 iPhone 可以當作遙控快門。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink использует Bluetooth, чтобы соседний iPhone мог работать как пульт затвора."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink uses the camera to take photos and videos, and to place an AR banner in the scene."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진과 동영상을 촬영하고, AR 현수막를 화면에 띄우기 위해 카메라를 사용합니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真やビデオを撮影し、ARの横断幕を画面に表示するために、カメラを使用します。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink uses the camera to take photos and videos, and to place an AR banner in the scene."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink 使用相机拍摄照片和视频，并在画面中放置 AR 横幅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink 使用相機拍攝照片和影片，並在畫面中放置 AR 布條。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink использует камеру, чтобы снимать фото и видео и показывать AR-баннер в кадре."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink records audio with your videos and listens for a clap when Clap shutter is on."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동영상 소리 녹음과 박수 셔터를 위해 마이크를 사용합니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオの音声を録音し、拍手シャッターを使うために、マイクを使用します。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink records audio with your videos and listens for a clap when Clap shutter is on."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink 会在录制视频时录入声音，并在开启拍手快门时监听拍手声。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink 會在錄影時收錄聲音，並在開啟拍手快門時偵測拍手聲。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink записывает звук для видео и слушает хлопок, когда включён затвор по хлопку."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink saves your photos and videos to your library."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "촬영한 사진과 동영상을 사진 보관함에 저장합니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撮影した写真やビデオを写真ライブラリに保存します。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink saves your photos and videos to your library."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink 会将你拍摄的照片和视频存入相册。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink 會將你拍攝的照片和影片儲存到相簿。"
          }
        },
