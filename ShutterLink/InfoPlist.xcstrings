    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink uses Bluetooth so a nearby iPhone can act as a remote shutter."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주변 iPhone을 리모컨 셔터로 쓰기 위해 Bluetooth를 사용합니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くのiPhoneをリモコンシャッターとして使うために、Bluetoothを使用します。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink uses Bluetooth so a nearby iPhone can act as a remote shutter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink 使用蓝牙，让附近的 iPhone 可以作为遥控快门。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink 使用藍牙，讓附近的 iPhone 可以當作遙控快門。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink использует Bluetooth, чтобы соседний iPhone мог работать как пульт затвора."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink usa Bluetooth para que un iPhone cercano funcione como disparador remoto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink nutzt Bluetooth, damit ein iPhone in der Nähe als Fernauslöser dienen kann."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink utilise le Bluetooth pour qu’un iPhone à proximité serve de télécommande de déclencheur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink usa il Bluetooth per far funzionare un iPhone vicino come telecomando dello scatto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ShutterLink usa o Bluetooth para que um iPhone por perto funcione como controle remoto do obturador."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink ใช้ Bluetooth เพื่อให้ iPhone เครื่องที่อยู่ใกล้ ๆ ทำหน้าที่เป็นรีโมตชัตเตอร์"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink dùng Bluetooth để một chiếc iPhone ở gần có thể làm điều khiển từ xa cho nút chụp."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink používá Bluetooth, aby mohl blízký iPhone sloužit jako dálkový ovladač spouště."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink bruger Bluetooth, så en iPhone i nærheden kan fungere som fjernudløser."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ShutterLink χρησιμοποιεί Bluetooth, ώστε ένα κοντινό iPhone να λειτουργεί ως τηλεχειριστήριο κλείστρου."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink käyttää Bluetoothia, jotta lähellä oleva iPhone voi toimia kaukolaukaisimena."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink memakai Bluetooth agar iPhone di dekatnya dapat berfungsi sebagai pemicu rana jarak jauh."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink bruker Bluetooth slik at en iPhone i nærheten kan fungere som fjernutløser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink gebruikt Bluetooth zodat een iPhone in de buurt als afstandsbediening voor de sluiter kan dienen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink używa Bluetooth, aby pobliski iPhone mógł pełnić rolę pilota migawki."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink uses the camera to take photos and videos, and to place an AR banner in the scene."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진과 동영상을 촬영하고, AR 현수막를 화면에 띄우기 위해 카메라를 사용합니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真やビデオを撮影し、ARの横断幕を画面に表示するために、カメラを使用します。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink uses the camera to take photos and videos, and to place an AR banner in the scene."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink 使用相机拍摄照片和视频，并在画面中放置 AR 横幅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink 使用相機拍攝照片和影片，並在畫面中放置 AR 布條。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink использует камеру, чтобы снимать фото и видео и показывать AR-баннер в кадре."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink usa la cámara para hacer fotos y vídeos y para colocar una pancarta AR en la escena."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink nutzt die Kamera, um Fotos und Videos aufzunehmen und ein AR-Banner in die Szene zu setzen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink utilise l’appareil photo pour prendre des photos et des vidéos et pour placer une banderole en RA dans la scène."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink usa la fotocamera per scattare foto e girare video e per inserire uno striscione AR nella scena."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ShutterLink usa a câmera para tirar fotos e gravar vídeos e para colocar uma faixa em RA na cena."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink ใช้กล้องเพื่อถ่ายภาพและวิดีโอ และวางแบนเนอร์ AR ลงในฉาก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink dùng camera để chụp ảnh, quay video và đặt băng rôn AR vào khung cảnh."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink používá fotoaparát k pořizování fotek a videí a k umístění AR banneru do scény."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink bruger kameraet til at tage billeder og videoer og til at placere et AR-banner i scenen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ShutterLink χρησιμοποιεί την κάμερα για λήψη φωτογραφιών και βίντεο και για την τοποθέτηση ενός πανό AR στη σκηνή."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink käyttää kameraa valokuvien ja videoiden ottamiseen sekä AR-bannerin asettamiseen kuvaan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink memakai kamera untuk mengambil foto dan video serta menempatkan spanduk AR di tempat Anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink bruker kameraet til å ta bilder og videoer og til å plassere et AR-banner i scenen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink gebruikt de camera om foto’s en video’s te maken en om een AR-spandoek in beeld te plaatsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink używa aparatu do robienia zdjęć i nagrywania filmów oraz do umieszczania baneru AR w kadrze."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink records audio with your videos and listens for a clap when Clap shutter is on."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동영상 소리 녹음과 박수 셔터를 위해 마이크를 사용합니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオの音声を録音し、拍手シャッターを使うために、マイクを使用します。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink records audio with your videos and listens for a clap when Clap shutter is on."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink 会在录制视频时录入声音，并在开启拍手快门时监听拍手声。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink 會在錄影時收錄聲音，並在開啟拍手快門時偵測拍手聲。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink записывает звук для видео и слушает хлопок, когда включён затвор по хлопку."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink graba audio con tus vídeos y escucha una palmada cuando el disparador por palmada está activado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink nimmt den Ton deiner Videos auf und lauscht auf ein Klatschen, wenn der Klatsch-Auslöser aktiv ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink enregistre le son de vos vidéos et écoute un claquement de mains lorsque le déclencheur par applaudissement est activé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink registra l’audio dei video e ascolta un applauso quando lo scatto con applauso è attivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ShutterLink grava o áudio dos seus vídeos e escuta uma palma quando o disparo por palmas está ligado."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink บันทึกเสียงไปกับวิดีโอ และคอยฟังเสียงปรบมือเมื่อเปิดใช้ชัตเตอร์ปรบมือ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink ghi âm thanh cùng video và lắng nghe tiếng vỗ tay khi bật chụp bằng tiếng vỗ tay."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink nahrává zvuk k videím a naslouchá tlesknutí, když je zapnutá spoušť tleskáním."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink optager lyd til dine videoer og lytter efter et klap, når klapudløseren er slået til."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ShutterLink εγγράφει ήχο με τα βίντεό σας και «ακούει» για χειροκρότημα όταν είναι ενεργό το κλείστρο με χειροκρότημα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink tallentaa videoihin äänen ja kuuntelee taputusta, kun taputuslaukaisu on päällä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink merekam suara bersama video dan mendengarkan tepukan tangan saat rana tepuk tangan aktif."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink tar opp lyd til videoene dine og lytter etter et klapp når klappeutløseren er på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink neemt geluid op bij je video’s en luistert naar een klap als de klapontspanner aan staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink nagrywa dźwięk do filmów i nasłuchuje klaśnięcia, gdy włączona jest migawka na klaśnięcie."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink saves your photos and videos to your library."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "촬영한 사진과 동영상을 사진 보관함에 저장합니다."
          }
        },
        "ja" : {
          "stringUnit" : {
