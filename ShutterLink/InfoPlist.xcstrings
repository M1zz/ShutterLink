          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink ukládá vaše fotky a videa do knihovny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink gemmer dine billeder og videoer i dit fotobibliotek."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ShutterLink αποθηκεύει τις φωτογραφίες και τα βίντεό σας στη βιβλιοθήκη φωτογραφιών σας."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink tallentaa ottamasi kuvat ja videot kuvakirjastoosi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink menyimpan foto dan video Anda ke pustaka foto."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShutterLink lagrer bildene og videoene dine i bildebiblioteket ditt."
          }
        },
